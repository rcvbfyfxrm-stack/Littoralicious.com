BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Littoralicious//Terroir Istanbul//EN
CALSCALE:GREGORIAN
BEGIN:VTODO
UID:terroir-ist-checklist-01@littoralicious.com
DTSTAMP:20260817T090000Z
SUMMARY:Simit off the vapur tray
DESCRIPTION:Buy it at the pier\, eat it on the deck between Eminönü and Kadıköy — the dark lacquer comes from a grape-molasses dip before the sesame.
END:VTODO
BEGIN:VTODO
UID:terroir-ist-checklist-02@littoralicious.com
DTSTAMP:20260817T090000Z
SUMMARY:Balık ekmek, done right
DESCRIPTION:Grilled mackerel in bread by the water — pick a counter that grills to order.
END:VTODO
BEGIN:VTODO
UID:terroir-ist-checklist-03@littoralicious.com
DTSTAMP:20260817T090000Z
SUMMARY:Midye dolma with lemon
DESCRIPTION:Stuffed mussels\, eaten standing\, one lemon-squeeze per shell.
END:VTODO
BEGIN:VTODO
UID:terroir-ist-checklist-04@littoralicious.com
DTSTAMP:20260817T090000Z
SUMMARY:Liver first at an ocakbaşı
DESCRIPTION:Sit at the charcoal trench: liver first\, then the skewers\, a lahmacun to close.
END:VTODO
BEGIN:VTODO
UID:terroir-ist-checklist-05@littoralicious.com
DTSTAMP:20260817T090000Z
SUMMARY:Serpme kahvaltı on a Sunday
DESCRIPTION:The sprawled breakfast — twenty small plates and an hour of it. Kahvaltı means "before coffee".
END:VTODO
BEGIN:VTODO
UID:terroir-ist-checklist-06@littoralicious.com
DTSTAMP:20260817T090000Z
SUMMARY:Fıstıklı kuru baklava at Karaköy Güllüoğlu
DESCRIPTION:The dry pistachio one\, no cream\, bought by weight — it survives being carried onto a boat.
END:VTODO
BEGIN:VTODO
UID:terroir-ist-checklist-07@littoralicious.com
DTSTAMP:20260817T090000Z
SUMMARY:Künefe, eaten hot
DESCRIPTION:The shredded-pastry and cheese dessert — it does not wait.
END:VTODO
BEGIN:VTODO
UID:terroir-ist-checklist-08@littoralicious.com
DTSTAMP:20260817T090000Z
SUMMARY:Boza at Vefa Bozacısı
DESCRIPTION:The 1876 house — winter drink\, cinnamon and roasted chickpeas on top.
END:VTODO
BEGIN:VTODO
UID:terroir-ist-checklist-09@littoralicious.com
DTSTAMP:20260817T090000Z
SUMMARY:Türk kahvesi brewed on sand
DESCRIPTION:At Fazıl Bey in Kadıköy — milled finer than espresso\, roasted for the cezve.
END:VTODO
BEGIN:VTODO
UID:terroir-ist-checklist-10@littoralicious.com
DTSTAMP:20260817T090000Z
SUMMARY:Çay in a tulip glass on the ferry deck
DESCRIPTION:From the tray that never spills. The cheapest good hour in the city.
END:VTODO
BEGIN:VTODO
UID:terroir-ist-checklist-11@littoralicious.com
DTSTAMP:20260817T090000Z
SUMMARY:Rakı-balık — the full meyhane night
DESCRIPTION:Cold mezes first\, the rakı with water and ice\, the fish chosen off the ice.
END:VTODO
BEGIN:VTODO
UID:terroir-ist-checklist-12@littoralicious.com
DTSTAMP:20260817T090000Z
SUMMARY:Tavuk göğsü or muhallebi
DESCRIPTION:The palace milk puddings — the restrained half of the city’s table.
END:VTODO
BEGIN:VTODO
UID:terroir-ist-checklist-13@littoralicious.com
DTSTAMP:20260817T090000Z
SUMMARY:İşkembe soup after midnight
DESCRIPTION:The tripe soup against the rakı — garlic vinegar on top.
END:VTODO
BEGIN:VTODO
UID:terroir-ist-checklist-14@littoralicious.com
DTSTAMP:20260817T090000Z
SUMMARY:A glass of Öküzgözü
DESCRIPTION:The juicy Anatolian red almost nobody outside Turkey orders.
END:VTODO
BEGIN:VTODO
UID:terroir-ist-checklist-15@littoralicious.com
DTSTAMP:20260817T090000Z
SUMMARY:Boğazkere with the lamb
DESCRIPTION:The tannic one — built for the fire counter.
END:VTODO
BEGIN:VTODO
UID:terroir-ist-checklist-16@littoralicious.com
DTSTAMP:20260817T090000Z
SUMMARY:Narince or Emir, white and cold
DESCRIPTION:Anatolian whites — Narince from Tokat\, Emir from Cappadocia.
END:VTODO
END:VCALENDAR
